# Anthropic API key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Set this in your Vercel project's Environment Variables for deployment.
# Without it, the app runs in offline mode and serves bundled fallback puzzles.
ANTHROPIC_API_KEY=

# Supabase — used for magic-link auth and the allowed_users access list.
# Found in your Supabase project: Settings → API.
# These are PUBLIC (safe to expose to the browser), hence the NEXT_PUBLIC_ prefix.
# If both are left blank, the auth gate is disabled and the site is open.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
